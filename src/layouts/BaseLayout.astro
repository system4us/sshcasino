    <!-- GLOBAL INTERACTIVE SCRIPTS (Simulated Counters & Live Toasts) -->
    <script is:inline>
      // Mobile menu toggle
      const mobileBtn = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      if (mobileBtn && mobileMenu) {
        mobileBtn.addEventListener('click', () => {
          mobileMenu.classList.toggle('hidden');
        });
      }

      // Simulated online SysAdmins & Jackpot counters
      const onlineEl = document.getElementById('online-sysadmins-count');
      const jackpotEl = document.getElementById('global-jackpot-counter');
      let currentOnline = 1337;
      let currentJackpot = 42891;

      setInterval(() => {
        const delta = Math.floor(Math.random() * 15) - 6;
        currentOnline = Math.max(1024, currentOnline + delta);
        currentJackpot += Math.floor(Math.random() * 4) + 1;
        if (onlineEl) onlineEl.textContent = currentOnline.toLocaleString();
        if (jackpotEl) jackpotEl.textContent = currentJackpot.toLocaleString();
      }, 3500);

      // Simulated Live Incident Toast rotator
      const toastEl = document.getElementById('simulated-toast');
      const toastMsgEl = document.getElementById('toast-message');
      const closeToastBtn = document.getElementById('close-toast-btn');
      let toastDismissed = window.sessionStorage.getItem('sshcasino_toast_closed') === '1';

      if (toastDismissed && toastEl) {
        toastEl.style.display = 'none';
      }

      if (closeToastBtn && toastEl) {
        closeToastBtn.addEventListener('click', () => {
          toastDismissed = true;
          toastEl.style.display = 'none';
          window.sessionStorage.setItem('sshcasino_toast_closed', '1');
        });
      }

      const simulatedEvents = [
        '<strong class="text-neon-gold">[JACKPOT]</strong> <strong class="text-neon-green">E-lon</strong> hit a 5-Click Mega Jackpot in DevOps Russian Roulette — <strong class="text-neon-green">+$120M/yr saved</strong> by unplugging Sacramento racks!',
        '<strong class="text-neon-green">[21 WIN]</strong> <strong class="text-neon-green">linus_git_force</strong> drew a Natural 21 in SSH Blackjack and won <strong class="text-neon-gold">10,000 Root Keys</strong> from the House!',
        '<strong class="text-neon-red">[OUTAGE]</strong> <strong class="text-neon-gold">cloud_architect_99</strong> landed on <code class="text-neon-red">00 (us-east-1)</code> in AWS Roulette — Jeff Bezos just bought another superyacht thruster!',
        '<strong class="text-neon-cyan">[BLUFF]</strong> <strong class="text-neon-cyan">database_admin</strong> bluffed the board in Database Poker, called a DB wipe "GDPR compliance" and won a <strong class="text-neon-green">+$45,000 bonus!</strong>',
        '<strong class="text-neon-red">[CRAPS]</strong> <strong class="text-neon-red">sre_intern</strong> rolled Snake Eyes in Kubernetes Craps and evicted all 140 production nodes!'
      ];
      let eventIndex = 0;

      setInterval(() => {
        if (toastDismissed || !toastEl || !toastMsgEl) return;
        eventIndex = (eventIndex + 1) % simulatedEvents.length;
        toastMsgEl.innerHTML = simulatedEvents[eventIndex];
      }, 8000);
    </script>
  </body>
