              <li><a href={withBase('/responsible-gambling')} class="hover:text-neon-green transition">Responsible Infrastructure Gambling</a></li>
              <li><a href={withBase('/security#privacy-terms')} class="hover:text-neon-green transition">Ephemeral `/tmp` Privacy Policy</a></li>
              <li><a href="https://system4us.com" target="_blank" rel="noopener noreferrer" class="text-neon-green font-bold hover:underline">system4us.com Security Platform ↗</a></li>
            </ul>
