---
import CyberIcon from './CyberIcon.astro';
import { withBase } from '../data/casinoData';

const pillars = [
  {
    id: 'guns',
    label: 'GUNS.',
    sub: '6-Chamber Revolver',
    icon: 'gun' as const,
    colorClass: 'text-neon-red border-neon-red/40',
    glowColor: '0xff2a54',
    modelUrl: withBase('/models/revolver-pbr.glb'),
    targetSize: 2.35,
  },
  {
    id: 'cars',
    label: 'CARS.',
    sub: 'Ferrari V12 GT',
    icon: 'car' as const,
    colorClass: 'text-neon-cyan border-neon-cyan/40',
    glowColor: '0x00f0ff',
    modelUrl: withBase('/models/ferrari.glb'),
    targetSize: 2.55,
  },
  {
    id: 'girls',
    label: 'GIRLS.',
    sub: 'Monte Carlo VIP Host',
    icon: 'girl' as const,
    colorClass: 'text-pink-500 border-pink-500/40',
    glowColor: '0xec4899',
    modelUrl: withBase('/models/girl.glb'),
    targetSize: 2.35,
  },
  {
    id: 'keys',
    label: 'KEYS.',
    sub: 'UID=0 Master Key',
    icon: 'key' as const,
    colorClass: 'text-neon-green border-neon-green/40',
    glowColor: '0x00ff66',
    modelUrl: withBase('/models/key.glb'),
    targetSize: 2.25,
  }
];
---

<div class="relative rounded-2xl border border-neon-gold/40 bg-gradient-to-r from-[#070a0f] via-[#0d131c] to-[#070a0f] overflow-hidden shadow-neon-gold my-6">
  <!-- Top Showroom Header -->
  <div class="border-b border-slate-800/80 bg-obsidian/90 px-4 py-2 flex items-center justify-between text-[10px] font-mono uppercase tracking-widest">
    <span class="px-2.5 py-0.5 rounded bg-neon-gold/15 text-neon-gold border border-neon-gold/40 font-bold flex items-center gap-1.5">
      <span class="h-1.5 w-1.5 rounded-full bg-neon-gold animate-ping"></span>
      VIP SYNDICATE SHOWROOM // PBR 3D ASSETS
    </span>
    <span class="text-slate-400 hidden sm:inline">CLICK ANY 3D PEDESTAL TO OVERCLOCK</span>
  </div>

  <!-- 4 Perfectly Aligned Columns (Each Column Has Its Own Centered 3D Viewport + Label Directly Underneath) -->
  <div class="grid grid-cols-2 sm:grid-cols-4 divide-x divide-y sm:divide-y-0 divide-slate-800/70">
    {pillars.map((item) => (
      <div
        class="slogan-pillar-card flex flex-col items-center justify-between p-3 sm:p-4 bg-gradient-to-b from-transparent via-[#090e14]/60 to-obsidian/90 cursor-pointer group hover:bg-slate-900/40 transition"
        data-model-url={item.modelUrl}
        data-glow-color={item.glowColor}
        data-target-size={item.targetSize}
      >
        <!-- Dedicated 3D Canvas Container Centered at (0,0,0) -->
        <div class="pillar-canvas-mount w-full h-32 sm:h-36 relative flex items-center justify-center"></div>

        <!-- Centered Label Directly Below the 3D Model -->
        <div class="w-full pt-2 border-t border-slate-800/60 flex flex-col items-center text-center font-mono">
          <div class={`flex items-center justify-center gap-1.5 font-black text-xs sm:text-sm tracking-widest uppercase ${item.colorClass.split(' ')[0]}`}>
            <CyberIcon name={item.icon} class="w-3.5 h-3.5 shrink-0" />
            <span>{item.label}</span>
          </div>
          <span class="text-[10px] text-slate-400 mt-0.5">{item.sub}</span>
        </div>
      </div>
    ))}
  </div>

  <!-- Bottom Slogan Bar -->
  <div class="border-t border-slate-800/90 bg-obsidian/95 px-5 py-2.5 flex flex-wrap items-center justify-between gap-2">
    <p class="font-mono text-xs sm:text-sm font-black uppercase tracking-[0.2em] text-transparent bg-clip-text bg-gradient-to-r from-neon-red via-neon-gold to-neon-green">
      "GUNS, CARS, GIRLS, KEYS. JOIN THE CREW."
    </p>
    <a href={withBase('/register')} class="text-[11px] font-mono font-bold uppercase tracking-wider text-neon-gold hover:text-neon-green transition flex items-center gap-1">
      <span>ENTER VIP LOUNGE</span>
      <span aria-hidden="true">→</span>
    </a>
  </div>
</div>

<script>
  import * as THREE from 'three';
  import { GLTFLoader } from 'three/examples/jsm/loaders/GLTFLoader.js';
  import { DRACOLoader } from 'three/examples/jsm/loaders/DRACOLoader.js';
  import { RoomEnvironment } from 'three/examples/jsm/environments/RoomEnvironment.js';

  const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
  const dracoLoader = new DRACOLoader();
  dracoLoader.setDecoderPath(`${baseUrl}/draco/`);
  const gltfLoader = new GLTFLoader();
  gltfLoader.setDRACOLoader(dracoLoader);

  const cards = document.querySelectorAll('.slogan-pillar-card');

  cards.forEach((card, idx) => {
    const mount = card.querySelector('.pillar-canvas-mount') as HTMLElement | null;
    if (!mount) return;

    const modelUrl = card.getAttribute('data-model-url') || '';
    const glowHex = Number(card.getAttribute('data-glow-color') || '0xeab308');
    const targetSize = parseFloat(card.getAttribute('data-target-size') || '2.3');

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(
      36,
      mount.clientWidth / mount.clientHeight,
      0.1,
      50
    );
    camera.position.set(0, 1.0, 4.2);
    camera.lookAt(0, 0, 0);

    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    renderer.setSize(mount.clientWidth, mount.clientHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.3;
    renderer.outputColorSpace = THREE.SRGBColorSpace;
    mount.appendChild(renderer.domElement);

    const pmrem = new THREE.PMREMGenerator(renderer);
    scene.environment = pmrem.fromScene(new RoomEnvironment(), 0.04).texture;

    const hemi = new THREE.HemisphereLight(0xfff2d8, 0x0b0f14, 1.2);
    scene.add(hemi);

    const dirLight = new THREE.DirectionalLight(0xffffff, 2.4);
    dirLight.position.set(3, 6, 5);
    scene.add(dirLight);

    const rimLight = new THREE.PointLight(glowHex, 5, 10);
    rimLight.position.set(0, 1.5, 2.5);
    scene.add(rimLight);

    // Centered glowing pedestal ring at exact (0, -0.85, 0)
    const pedRing = new THREE.Mesh(
      new THREE.RingGeometry(0.75, 0.95, 48),
      new THREE.MeshBasicMaterial({ color: glowHex, side: THREE.DoubleSide })
    );
    pedRing.rotation.x = -Math.PI / 2;
    pedRing.position.set(0, -0.85, 0);
    scene.add(pedRing);

    const pivot = new THREE.Group();
    pivot.position.set(0, 0, 0);
    scene.add(pivot);

    gltfLoader.load(modelUrl, (gltf) => {
      const model = gltf.scene;
      const box = new THREE.Box3().setFromObject(model);
      const size = box.getSize(new THREE.Vector3());
      const center = box.getCenter(new THREE.Vector3());

      const maxDim = Math.max(size.x, size.y, size.z) || 1;
      const scale = targetSize / maxDim;
      model.scale.setScalar(scale);

      model.position.set(
        -center.x * scale,
        -center.y * scale,
        -center.z * scale
      );

      pivot.add(model);
    });

    let speedMultiplier = 1;
    let clock = idx * 1.2;

    function animate() {
      requestAnimationFrame(animate);
      clock += 0.025 * speedMultiplier;

      pivot.rotation.y += (idx % 2 === 0 ? 0.016 : -0.016) * speedMultiplier;
      pivot.position.y = Math.sin(clock) * 0.06;

      if (speedMultiplier > 1) {
        speedMultiplier *= 0.95;
        if (speedMultiplier < 1.02) speedMultiplier = 1;
      }

      renderer.render(scene, camera);
    }
    animate();

    card.addEventListener('click', () => {
      speedMultiplier = 8;
    });

    window.addEventListener('resize', () => {
      if (!mount) return;
      camera.aspect = mount.clientWidth / mount.clientHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(mount.clientWidth, mount.clientHeight);
    });
  });
</script>
