---
import BaseLayout from '../layouts/BaseLayout.astro';
import SecurityPromoBanner from '../components/SecurityPromoBanner.astro';
import CyberIcon from '../components/CyberIcon.astro';
import { hallOfFame, testimonials } from '../data/casinoData';

const dangerousCredentials = [
  {
    cred: 'root / admin123 (Port 22 Open to 0.0.0.0/0)',
    owner: 'legacy-erp-vm-01',
    survivalTime: '1.4 Seconds',
    outcome: 'Hijacked by 19 competing botnets who now fight each other for CPU cycles'
  },
  {
    cred: 'AKIAIOSFODNN7EXAMPLECommittedToPublicGitHub',
    owner: 'frontend-vibe-repo',
    survivalTime: '0.8 Seconds',
    outcome: 'Spun up 128 p4d.24xlarge GPU instances mining Dogecoin in eu-west-1'
  },
  {
    cred: 'chmod 777 ~/.ssh/id_rsa (Shared in #general Slack)',
    owner: 'entire-engineering-org',
    survivalTime: '4 Months (Somehow)',
    outcome: 'Wagered on SSH Blackjack; Dealer doubled down and locked out the CTO'
  },
  {
    cred: 'postgres://postgres:postgres@prod-db.company.com:5432/prod',
    owner: 'microservices-monolith',
    survivalTime: '12 Minutes',
    outcome: 'Went All-In on Database Poker; replaced all user emails with ASCII art'
  }
];

const monthlyDisasters = [
  {
    month: 'OCTOBER — THE GREAT TERRAFORM STATE WIPE',
    summary: 'Player `iac_wizard` deleted the remote S3 state lock table mid-apply while playing AWS Roulette.',
    damage: '312 orphaned load balancers, 0 surviving EC2 instances.'
  },
  {
    month: 'SEPTEMBER — REGEX OF DOOM (`rm -rf / .*`)',
    summary: 'A malformed bash cleanup script in DevOps Russian Roulette traversed `..` and erased the host hypervisor.',
    damage: 'Entire bare-metal rack converted into expensive space heaters.'
  },
  {
    month: 'AUGUST — THE 10,000 REPLICA HELM CHART',
    summary: 'In Kubernetes Craps, an extra zero in `replicaCount: 10000` triggered an autoscaling feedback loop.',
    damage: 'Cloud provider called the CEO personally to ask if we were DDoSing ourselves.'
  }
];
---

<BaseLayout
  title="Hall of Fame & Wall of Shame — sshCasino | Legendary Production Incidents"
  description="Browse the top high-roller players, biggest infrastructure jackpots, most dangerous credentials, and legendary production postmortems at sshCasino."
>
  <section class="py-14 md:py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-20">
    <!-- Page Header -->
    <div class="max-w-3xl space-y-4">
      <div class="inline-flex items-center gap-2 rounded-full border border-neon-gold/40 bg-neon-gold/10 px-3.5 py-1 text-xs font-mono uppercase tracking-widest text-neon-gold">
        <CyberIcon name="trophy" class="w-4 h-4" />
        <span>IMMORTALIZED HIGH-ROLLER LEADERBOARD</span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-display font-black text-white">
        HALL OF FAME & <span class="text-neon-red">WALL OF SHAME</span>
      </h1>
      <p class="text-slate-300 text-base sm:text-lg leading-relaxed">
        Anyone can maintain 99.99% uptime by being careful. Takes a true high-roller to bet the entire production namespace on a Friday evening and walk away with a Mega Jackpot—or a legendary postmortem.
      </p>
    </div>

    <!-- Top Players / Biggest Fictional Losses Table -->
    <div class="rounded-2xl border border-slate-800 bg-card overflow-hidden shadow-2xl">
      <div class="bg-vault px-6 py-5 border-b border-slate-800 flex flex-wrap items-center justify-between gap-4">
        <div>
          <h2 class="text-xl sm:text-2xl font-display font-bold text-white">
            All-Time High Rollers: Mega Jackpot Winners & Legendary Losses
          </h2>
          <p class="text-xs font-mono text-slate-400 mt-0.5">
            Only legends like E-lon and Linus have beaten the House. Everyone else donated their clusters.
          </p>
        </div>
        <div class="flex flex-wrap gap-2">
          <span class="text-xs font-mono px-3 py-1 rounded bg-neon-green/15 text-neon-green border border-neon-green/40 font-bold">
            BIGGEST JACKPOT WON: +$120M/YR (E-LON)
          </span>
          <span class="text-xs font-mono px-3 py-1 rounded bg-neon-red/15 text-neon-red border border-neon-red/30 font-bold">
            SERVERS LIQUIDATED: 4,892
          </span>
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left font-mono text-xs">
          <thead>
            <tr class="border-b border-slate-800 bg-obsidian/60 text-slate-400 uppercase">
              <th class="py-3.5 px-4">RANK</th>
              <th class="py-3.5 px-4">PLAYER</th>
              <th class="py-3.5 px-4">OUTCOME</th>
              <th class="py-3.5 px-4">GAME & WAGER</th>
              <th class="py-3.5 px-4">LEGENDARY PLAY</th>
              <th class="py-3.5 px-4">NET RESULT / STATUS</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800/80">
            {hallOfFame.map((entry) => {
              const isWin = entry.outcomeType !== 'TOTAL LIQUIDATION';
              return (
                <tr class={`hover:bg-vault/60 transition ${entry.rank === 1 ? 'bg-neon-gold/10' : ''}`}>
                  <td class="py-4 px-4 font-black text-neon-gold">
                    <div class="flex items-center gap-1.5">
                      {entry.rank === 1 && <CyberIcon name="crown" class="w-4 h-4 text-neon-gold" />}
                      <span>#{entry.rank}</span>
                    </div>
                  </td>
                  <td class="py-4 px-4">
                    <div class="flex items-center gap-3">
                      {entry.avatarUrl && (
                        <img
                          src={entry.avatarUrl}
                          alt={entry.handle}
                          class="h-10 w-10 rounded-full object-cover border-2 border-neon-gold"
                        />
                      )}
                      <div>
                        <div class="font-bold text-neon-green">{entry.handle}</div>
                        <div class="text-[10px] text-slate-400">{entry.role}</div>
                      </div>
                    </div>
                  </td>
                  <td class="py-4 px-4 whitespace-nowrap">
                    <span class={`inline-block px-2.5 py-1 rounded text-[10px] font-bold border ${
                      isWin
                        ? 'bg-neon-green/15 text-neon-green border-neon-green/40'
                        : 'bg-neon-red/15 text-neon-red border-neon-red/30'
                    }`}>
                      {entry.outcomeType}
                    </span>
                  </td>
                  <td class="py-4 px-4">
                    <div class="text-white font-bold">{entry.game}</div>
                    <div class="text-[11px] text-slate-400">{entry.wager}</div>
                  </td>
                  <td class={`py-4 px-4 font-semibold ${isWin ? 'text-slate-200' : 'text-neon-red'}`}>
                    {entry.loss}
                  </td>
                  <td class="py-4 px-4">
                    <div class={`font-bold ${isWin ? 'text-neon-gold' : 'text-neon-red'}`}>
                      {entry.netResult}
                    </div>
                    <span class="inline-block mt-1 px-2 py-0.5 rounded bg-slate-800 text-slate-300 text-[10px]">
                      {entry.status}
                    </span>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Most Dangerous Credentials & Monthly Disasters Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      <!-- Most Dangerous Credentials -->
      <div class="lg:col-span-7 rounded-2xl border border-slate-800 bg-card p-6 sm:p-8 space-y-6">
        <div>
          <div class="text-xs font-mono uppercase tracking-widest text-neon-red flex items-center gap-2">
            <CyberIcon name="alert" class="w-4 h-4" />
            <span>MUSEUM OF BAD OPSEC</span>
          </div>
          <h2 class="text-2xl font-display font-bold text-white mt-1">
            Most Dangerous Credentials Wagered
          </h2>
        </div>

        <div class="space-y-4">
          {dangerousCredentials.map((item) => (
            <div class="rounded-xl border border-slate-800 bg-obsidian p-4 space-y-2">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <code class="text-xs font-mono font-bold text-neon-gold break-all">{item.cred}</code>
                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-neon-red/15 text-neon-red border border-neon-red/30">
                  TTI: {item.survivalTime}
                </span>
              </div>
              <p class="text-xs text-slate-300">{item.outcome}</p>
              <div class="text-[10px] font-mono text-slate-500">Host: {item.owner}</div>
            </div>
          ))}
        </div>
      </div>

      <!-- Monthly Disasters -->
      <div class="lg:col-span-5 rounded-2xl border border-slate-800 bg-card p-6 sm:p-8 space-y-6">
        <div>
          <div class="text-xs font-mono uppercase tracking-widest text-neon-gold flex items-center gap-2">
            <CyberIcon name="flame" class="w-4 h-4" />
            <span>MONTHLY INCIDENT ARCHIVE</span>
          </div>
          <h2 class="text-2xl font-display font-bold text-white mt-1">
            Legendary Production Incidents
          </h2>
        </div>

        <div class="space-y-4">
          {monthlyDisasters.map((d) => (
            <div class="rounded-xl border border-slate-800 bg-vault p-4 space-y-2">
              <div class="text-xs font-mono font-bold text-neon-green">{d.month}</div>
              <p class="text-xs text-slate-300 leading-relaxed">{d.summary}</p>
              <div class="text-[11px] font-mono text-neon-red font-semibold pt-1">
                Impact: {d.damage}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Wall of Shame Testimonials -->
    <div>
      <div class="mb-8">
        <div class="text-xs font-mono uppercase tracking-widest text-neon-green">WINNERS & WALL OF SHAME</div>
        <h2 class="text-3xl font-display font-black text-white mt-1">
          What High Rollers & Former SysAdmins Say
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {testimonials.map((t) => (
          <blockquote class="rounded-2xl border border-slate-800 bg-card p-6 flex flex-col justify-between hover:border-neon-gold/50 transition">
            <div>
              <div class="flex items-center justify-between gap-2 mb-4">
                <div class="flex items-center gap-3">
                  {t.imageUrl ? (
                    <img
                      src={t.imageUrl}
                      alt={t.author}
                      class="h-12 w-12 rounded-full object-cover border-2 border-neon-gold"
                    />
                  ) : (
                    <span class="h-12 w-12 rounded-full bg-vault border border-slate-700 flex items-center justify-center text-neon-green">
                      <CyberIcon name={t.avatar} class="w-6 h-6" />
                    </span>
                  )}
                  <div>
                    <div class="font-mono text-xs font-bold text-white">{t.author}</div>
                    {t.verifiedTag && (
                      <span class="text-[9px] font-mono uppercase px-1.5 py-0.5 rounded bg-neon-green/15 text-neon-green border border-neon-green/30">
                        {t.verifiedTag}
                      </span>
                    )}
                  </div>
                </div>
                <span class={`text-[10px] font-mono px-2 py-0.5 rounded border shrink-0 font-bold ${
                  t.isWinner
                    ? 'bg-neon-green/15 text-neon-green border-neon-green/40'
                    : 'bg-neon-red/15 text-neon-red border-neon-red/30'
                }`}>
                  {t.lost}
                </span>
              </div>
              <p class="text-slate-200 text-sm sm:text-base italic leading-relaxed">
                "{t.quote}"
              </p>
            </div>
            <footer class="mt-6 pt-4 border-t border-slate-800/80">
              <div class="font-mono text-xs font-bold text-neon-green">— {t.author}</div>
              <div class="font-mono text-[11px] text-slate-500">{t.company}</div>
            </footer>
          </blockquote>
        ))}
      </div>
    </div>

    <SecurityPromoBanner variant="banner" />
  </section>
</BaseLayout>
