---
import BaseLayout from '../layouts/BaseLayout.astro';
import SecurityPromoBanner from '../components/SecurityPromoBanner.astro';
import CyberIcon from '../components/CyberIcon.astro';
import { withBase } from '../data/casinoData';

const team = [
  {
    name: 'Viktor "UID 0" Vance',
    role: 'Founder & Pit Boss-in-Chief',
    bio: 'Former Principal SRE who accidentally wiped three availability zones in 2017 and realized the adrenaline rush was way more lucrative than maintaining uptime.',
    favGame: 'DevOps Russian Roulette',
    icon: 'revolver' as const
  },
  {
    name: 'Elena "DROP CASCADE" Rostova',
    role: 'Head of Database Poker & High-Roller Liquidity',
    bio: 'Holds the world record for executing an unindexed schema migration on a 12TB table during Cyber Monday without a transaction block.',
    favGame: 'Database Poker',
    icon: 'poker' as const
  },
  {
    name: 'Marcus "us-east-1" Sterling',
    role: 'VP of Cloud Billing & Odds Engineering',
    bio: 'Designed the mathematical model that ensures every spin of AWS Roulette triggers at least $14,000 in cross-AZ NAT Gateway data transfer fees.',
    favGame: 'AWS Roulette',
    icon: 'roulette' as const
  },
  {
    name: 'Satoshi YAMLmoto',
    role: 'Chief Kubernetes Craps Croupier',
    bio: 'Communicates exclusively in 600-line Helm values files. Can spot a missing two-space indentation from across a crowded casino floor.',
    favGame: 'Kubernetes Craps',
    icon: 'dice' as const
  }
];
---

<BaseLayout
  title="About Us — sshCasino | Our Story, Mission & Pit Bosses"
  description="We believe infrastructure management is already stressful enough. That's why we created a high-stakes casino to make it worse."
>
  <section class="py-14 md:py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-20">
    <!-- Hero Quote -->
    <div class="max-w-4xl space-y-6">
      <div class="inline-flex items-center gap-2 rounded-full border border-neon-gold/40 bg-neon-gold/10 px-3.5 py-1 text-xs font-mono uppercase tracking-widest text-neon-gold">
        <CyberIcon name="crown" class="w-4 h-4" />
        <span>CORPORATE HERITAGE & MANIFESTO</span>
      </div>
      <h1 class="text-4xl sm:text-6xl font-display font-black text-white leading-tight">
        "We believe infrastructure management is already stressful enough. <span class="text-neon-green">That's why we created a casino to make it worse.</span>"
      </h1>
      <p class="text-slate-300 text-base sm:text-lg leading-relaxed max-w-3xl">
        Founded in a dark server room at 3:42 AM during a multi-day SEV-1 incident, <strong>sshCasino</strong> was born from a simple observation: every time an engineer runs a deployment without staging or shares a root SSH key over Slack, they are already gambling. We simply added neon lights, velvet ropes, and a formal rulebook.
      </p>
    </div>

    <!-- History, Mission & Philosophy Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="rounded-2xl border border-slate-800 bg-card p-6 sm:p-8 space-y-3">
        <div class="text-xs font-mono font-bold uppercase tracking-widest text-neon-green">01 // OUR ORIGIN STORY</div>
        <h2 class="text-xl font-display font-bold text-white">Born from a Bad `rm -rf`</h2>
        <p class="text-sm text-slate-300 leading-relaxed">
          In 2021, our founders watched a junior engineer paste a stackoverflow command into a production root terminal. As 400 servers vanished in six seconds, the room fell silent—and someone whispered, <em>"I bet $50 the backups are empty too."</em> They were. sshCasino was incorporated the very next morning.
        </p>
      </div>

      <div class="rounded-2xl border border-slate-800 bg-card p-6 sm:p-8 space-y-3">
        <div class="text-xs font-mono font-bold uppercase tracking-widest text-neon-gold">02 // MISSION & VISION</div>
        <h2 class="text-xl font-display font-bold text-white">Democratizing Outages</h2>
        <p class="text-sm text-slate-300 leading-relaxed">
          Our mission is to shine a high-voltage neon spotlight on the extreme risks engineering teams take every single day with unmanaged credentials, unverified backups, and over-privileged cloud accounts.
        </p>
      </div>

      <div class="rounded-2xl border border-slate-800 bg-card p-6 sm:p-8 space-y-3">
        <div class="text-xs font-mono font-bold uppercase tracking-widest text-neon-red">03 // HOUSE PHILOSOPHY</div>
        <h2 class="text-xl font-display font-bold text-white">The House Always Wins</h2>
        <p class="text-sm text-slate-300 leading-relaxed">
          Entropy, Murphy's Law, and `us-east-1` always collect their debt. Whether you play at our VIP tables or in your own production environment, static SSH keys and standing root privileges eventually lose to the House.
        </p>
      </div>
    </div>

    <!-- Executive Team -->
    <div>
      <div class="mb-8">
        <div class="text-xs font-mono uppercase tracking-widest text-neon-gold">THE PIT BOSSES</div>
        <h2 class="text-3xl font-display font-black text-white mt-1">
          Meet Our Executive Pit Bosses
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {team.map((member) => (
          <div class="rounded-2xl border border-slate-800 bg-card p-6 flex flex-col justify-between">
            <div>
              <div class="h-11 w-11 rounded-xl border border-neon-gold/40 bg-obsidian flex items-center justify-center text-neon-gold mb-4">
                <CyberIcon name={member.icon} class="w-6 h-6" />
              </div>
              <h3 class="text-lg font-display font-bold text-white">{member.name}</h3>
              <div class="text-xs font-mono text-neon-green mt-0.5">{member.role}</div>
              <p class="text-xs text-slate-300 mt-3 leading-relaxed">{member.bio}</p>
            </div>
            <div class="mt-5 pt-3 border-t border-slate-800 text-[11px] font-mono text-slate-400">
              Table of Choice: <strong class="text-neon-gold">{member.favGame}</strong>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Contact / Parody Press Inquiries -->
    <div class="rounded-2xl border border-slate-800 bg-vault p-6 sm:p-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      <div class="lg:col-span-8 space-y-2">
        <div class="text-xs font-mono uppercase tracking-widest text-neon-green">CONTACT THE PIT BOSS</div>
        <h3 class="text-2xl font-display font-bold text-white">
          Have a Legendary Postmortem or Security Question?
        </h3>
        <p class="text-sm text-slate-300">
          For VIP press inquiries, confessional incident stories, or to learn how our enterprise security platform stops SSH and cloud credential gambling:
        </p>
        <div class="pt-2 flex flex-wrap gap-4 font-mono text-xs text-neon-gold">
          <span>pitboss@sshcasino.local</span>
          <span>•</span>
          <span>PagerDuty Escalation: /dev/null</span>
        </div>
      </div>
      <div class="lg:col-span-4 flex lg:justify-end">
        <a
          href={withBase('/coming-soon')}
          class="btn-casino-primary inline-flex items-center gap-2 rounded-xl px-6 py-4 text-xs font-mono font-black uppercase tracking-widest"
        >
          <CyberIcon name="shield" class="w-4 h-4" />
          <span>SECURITY PLATFORM (COMING SOON) →</span>
        </a>
      </div>
    </div>

    <SecurityPromoBanner variant="banner" />
  </section>
</BaseLayout>
